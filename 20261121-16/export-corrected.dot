digraph Review {
  graph [label="Reviewed assumptions: Training pilot · assumed causal structure", labelloc="t"];
  X [label="X: Enrollment in a staff training course", style="solid", shape="box"];
  Y [label="Y: Final assessment examination score", style="solid", shape="doublecircle"];
  C [label="C: Previous job experience before training", style="solid", shape="ellipse"];
  U [label="U: Unrecorded supervisor encouragement", style="dashed", shape="ellipse"];
  V [label="V: Unrecorded test anxiety", style="dashed", shape="ellipse"];
  K [label="K: Completion of a voluntary research questionnaire", style="solid", shape="ellipse"];
  M [label="M: Practice exercises completed after enrollment", style="solid", shape="ellipse"];
  V -> X;
  C -> Y;
  U -> X;
  U -> K;
  V -> K;
  V -> Y;
  X -> M;
  M -> Y;
}