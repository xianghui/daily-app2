digraph Review {
  graph [label="INCOMPLETE DRAFT: Website redesign · assumed causal structure", labelloc="t"];
  X [label="X: Exposure to the redesigned website layout", style="solid", shape="box"];
  Y [label="Y: Checkout purchase completion", style="solid", shape="doublecircle"];
  A [label="A: Device type used to browse the website", style="solid", shape="ellipse"];
  B [label="B: Returning customer purchase history", style="solid", shape="ellipse"];
  L [label="L: Unobserved advertising influence", style="dashed", shape="ellipse"];
  Z [label="Z: Joining an optional feedback survey", style="solid", shape="ellipse"];
  A -> X;
  B -> X;
  B -> Y;
  L -> X;
  L -> Y;
  X -> Z;
  Y -> Z;
  // Held arrow E2 is unresolved; no adjustment recommendation.
}