{
  "format": "range-relay-test-cases-v1",
  "notice": "Dry-run GET fixtures assuming Range is honored and bytes use an unchanged identity representation. No URL requests. Not full HTTP conformance. Coalesce adjacent ranges; multipart payload counts exclude framing.",
  "cases": [
    {
      "id": "Interrupted archive",
      "contract": "resume-download",
      "range": "bytes=200-",
      "length": 250,
      "expectedStatus": 206,
      "intervals": [
        [
          200,
          249
        ]
      ],
      "contentRanges": [
        "bytes 200-249/250"
      ],
      "unsatisfiedContentRange": null,
      "multipart": false,
      "payloadBytes": 50
    },
    {
      "id": "Magic signature",
      "contract": "header-preview",
      "range": "bytes=0-99",
      "length": 65,
      "expectedStatus": 206,
      "intervals": [
        [
          0,
          64
        ]
      ],
      "contentRanges": [
        "bytes 0-64/65"
      ],
      "unsatisfiedContentRange": null,
      "multipart": false,
      "payloadBytes": 65
    },
    {
      "id": "Footer metadata",
      "contract": "trailer-inspection",
      "range": "bytes=-80",
      "length": 1000,
      "expectedStatus": 206,
      "intervals": [
        [
          920,
          999
        ]
      ],
      "contentRanges": [
        "bytes 920-999/1000"
      ],
      "unsatisfiedContentRange": null,
      "multipart": false,
      "payloadBytes": 80
    },
    {
      "id": "Empty object",
      "contract": "header-preview",
      "range": "bytes=0-99",
      "length": 0,
      "expectedStatus": 416,
      "intervals": [],
      "contentRanges": [],
      "unsatisfiedContentRange": "bytes */0",
      "multipart": false,
      "payloadBytes": 0
    }
  ]
