{
  "format": "origin-ledger-fixtures-v1",
  "notice": "Offline bounded CORS QA snapshots; no network calls. Denied means browser response access fails, not that the request cannot be sent or that the endpoint is secured.",
  "cases": [
    {
      "id": "Partner permission",
      "client": {
        "id": "partner",
        "description": "Partner automation console sending custom integration job headers for bulk imports without session cookies.",
        "origin": "https://partners.example",
        "credentials": "omit"
      },
      "snapshot": {
        "method": "POST",
        "headers": {
          "x-job": "sample"
        },
        "response": {
          "allowOrigin": "*",
          "allowCredentials": ""
        },
        "preflight": {
          "status": 204,
          "allowOrigin": "*",
          "allowCredentials": "",
          "allowMethods": [],
          "allowHeaders": [
            "x-job"
          ]
        }
      },
      "expected": "readable",
      "preflightRequired": true
    },
    {
      "id": "Missing session permission",
      "client": {
        "id": "account",
        "description": "Signed in customer account portal using session cookies to view private orders and update the customer profile.",
        "origin": "https://account.example",
        "credentials": "include"
      },
      "snapshot": {
        "method": "GET",
        "headers": {},
        "response": {
          "allowOrigin": "https://account.example",
          "allowCredentials": ""
        },
        "preflight": null
      },
      "expected": "denied",
      "preflightRequired": false
    },
    {
      "id": "Anonymous JSON",
      "client": {
        "id": "public",
        "description": "Anonymous public data dashboard fetching open statistics without signing in or sending session credentials.",
        "origin": "https://charts.example",
        "credentials": "omit"
      },
      "snapshot": {
        "method": "POST",
        "headers": {
          "content-type": "application/json"
        },
        "response": {
          "allowOrigin": "*",
          "allowCredentials": ""
        },
        "preflight": {
          "status": 403,
          "allowOrigin": "*",
          "allowCredentials": "",
          "allowMethods": [
            "POST"
          ],
          "allowHeaders": [
            "content-type"
          ]
        }
      },
      "expected": "denied",
      "preflightRequired": true
    },
    {
      "id": "Cookie wildcard method",
      "client": {
        "id": "account",
        "description": "Signed in customer account portal using session cookies to view private orders and update the customer profile.",
        "origin": "https://account.example",
        "credentials": "include"
      },
      "snapshot": {
        "method": "PATCH",
        "headers": {},
        "response": {
          "allowOrigin": "https://account.example",
          "allowCredentials": "true"
        },
        "preflight": {
          "status": 204,
          "allowOrigin": "https://account.example",
          "allowCredentials": "true",
          "allowMethods": [
            "*"
          ],
          "allowHeaders": []
        }
      },
      "expected": "denied",
      "preflightRequired": true
    }
  ]
}