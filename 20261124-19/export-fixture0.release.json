          "domain": "shop.example.test",
          "hostOnly": true,
          "path": "/catalog",
          "secure": true,
          "sameSite": "None"
        },
        {
          "name": "parent",
          "value": "synthetic-parent",
          "domain": "example.test",
          "hostOnly": false,
          "path": "/",
          "secure": true,
          "sameSite": "Lax"
        }
      ],
      "expectedCookieHeader": "session=synthetic-session; embed=synthetic-embed; preference=synthetic-preference; session=synthetic-session; parent=synthetic-parent",
      "includedIndices": [
