  "cases": [
    {
      "id": "Checkout page",
      "request": {
        "id": "checkout",
        "description": "Customer browsing the store checkout within the same shopping website, opening their basket and paying.",
        "url": "https://shop.example.test/cart/pay",
        "crossSite": false,
        "topNavigation": true,
        "method": "GET"
      },
      "cookies": [
        {
          "name": "session",
          "value": "synthetic-session",
          "domain": "shop.example.test",
          "hostOnly": true,
          "path": "/cart",
          "secure": true,
          "sameSite": "Strict"
        },
        {
          "name": "preference",
          "value": "synthetic-preference",
          "domain": "shop.example.test",
          "hostOnly": true,
          "path": "/",
          "secure": true,
          "sameSite": "Lax"
        },
