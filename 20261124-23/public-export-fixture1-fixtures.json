{
  "app": "Selector Desk",
  "scope": "Approved explicit styles only; no website access or mutations. Author-only unlayered compound selector subset.",
  "rules": [
    {
      "selector": ".field.search, #hold",
      "property": "font-weight",
      "value": "700",
      "important": false
    },
    {
      "selector": "input",
      "property": "font-weight",
      "value": "400",
      "important": false
    },
    {
      "selector": ".reserve",
      "property": "display",
      "value": "inline-block",
      "important": true
    },
    {
      "selector": "#hold",
      "property": "display",
      "value": "none",
      "important": false
    },
    {
      "selector": "p",
      "property": "font-size",
      "value": "12px",
      "important": false
    }
  ],
  "cases": [
    {
      "id": "Catalog keywords",
      "element": {
        "id": "search",
        "description": "Library search field: type keywords to find books in the academic catalog.",
        "tag": "input",
        "elementId": "query",
        "classes": [
          "field",
          "search"
        ]
      },
      "property": "font-weight",
      "expected": "700",
      "winningRule": 0
    },
    {
      "id": "Borrow action",
      "element": {
        "id": "reserve",
        "description": "Book reservation button: borrow a library book and place a hold for pickup.",
        "tag": "button",
        "elementId": "hold",
        "classes": [
          "action",
          "reserve"
        ]
      },
      "property": "display",
      "expected": "inline-block",
      "winningRule": 2
    }
  ]
}