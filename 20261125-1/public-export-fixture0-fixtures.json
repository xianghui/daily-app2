{
  "app": "Merge Lantern",
  "scope": "Independent dry-run RFC 7396 test cases; no API calls. application/merge-patch+json, not RFC 6902 JSON Patch.",
  "cases": [
    {
      "id": "Receipt cleanup",
      "snapshot": "orders",
      "mediaType": "application/merge-patch+json",
      "target": {
        "receipt": {
          "currency": "USD",
          "footer": "Thanks",
          "copies": 2
        },
        "channels": [
          "email",
          "print"
        ],
        "legacy": "v1"
      },
      "patch": {
        "receipt": {
          "footer": null
        },
        "channels": [
          "email"
        ]
      },
      "expected": {
        "receipt": {
          "currency": "USD",
          "copies": 2
        },
        "channels": [
          "email"
        ],
        "legacy": "v1"
      }
    },
    {
      "id": "Directory change",
      "snapshot": "people",
      "mediaType": "application/merge-patch+json",
      "target": {
        "directory": {
          "office": "North",
          "phone": "555-0100"
        },
        "visible": true,
        "tags": [
          "staff"
        ]
      },
      "patch": {
        "directory": {
          "phone": null
        },
        "visible": false
      },
      "expected": {
        "directory": {
          "office": "North"
        },
        "visible": false,
        "tags": [
          "staff"
        ]
      }
    },
    {
      "id": "Dispatch labels",
      "snapshot": "shipping",
      "mediaType": "application/merge-patch+json",
      "target": {
        "dispatch": {
          "courier": "Synthetic Express",
          "zone": "A"
        },
        "labels": [
          "small",
          "large"
        ],
        "obsolete": true
      },
      "patch": {
        "labels": [
          "thermal"
        ],
        "obsolete": null
      },
      "expected": {
        "dispatch": {
          "courier": "Synthetic Express",
          "zone": "A"
        },
        "labels": [
          "thermal"
        ]
      }
    }
  ]
}