{
  "app": "Vary Ledger",
  "scope": "Independent cache-key QA fixtures; no network requests.",
  "cases": [
    {
      "id": "Help pages",
      "contract": "language",
      "mediaType": "application/json",
      "varyContract": {
        "vary": [
          "accept-language"
        ]
      },
      "batch": {
        "url": "/synthetic/resource",
        "requests": [
          {
            "headers": {
              "accept-language": "en"
            },
            "representation": "version-A"
          },
          {
            "headers": {
              "accept-language": "fr"
            },
            "representation": "version-B"
          }
        ]
      },
      "expected": [
        {
          "index": 0,
          "headers": {
            "accept-language": "en"
          },
          "representation": "version-A",
          "key": "[\"/synthetic/resource\",[\"accept-language\",\"en\"]]"
        },
        {
          "index": 1,
          "headers": {
            "accept-language": "fr"
          },
          "representation": "version-B",
          "key": "[\"/synthetic/resource\",[\"accept-language\",\"fr\"]]"
        }
      ]
    },
    {
      "id": "Asset transfer",
      "contract": "compression",
      "mediaType": "application/json",
      "varyContract": {
        "vary": [
          "accept-encoding"
        ]
      },
      "batch": {
        "url": "/synthetic/resource",
        "requests": [
          {
            "headers": {
              "accept-encoding": "gzip"
            },
            "representation": "version-A"
          },
          {
            "headers": {
              "accept-encoding": "br"
            },
            "representation": "version-B"
          }
        ]
      },
      "expected": [
        {
          "index": 0,
          "headers": {
            "accept-encoding": "gzip"
          },
          "representation": "version-A",
          "key": "[\"/synthetic/resource\",[\"accept-encoding\",\"gzip\"]]"
        },
        {
          "index": 1,
          "headers": {
            "accept-encoding": "br"
          },
          "representation": "version-B",
          "key": "[\"/synthetic/resource\",[\"accept-encoding\",\"br\"]]"
        }
      ]
    },
    {
      "id": "Partner access",
      "contract": "origin",
      "mediaType": "application/json",
      "varyContract": {
        "vary": [
          "origin"
        ]
      },
      "batch": {
        "url": "/synthetic/resource",
        "requests": [
          {
            "headers": {
              "origin": "https://a.example"
            },
            "representation": "version-A"
          },
          {
            "headers": {
              "origin": "https://b.example"
            },
            "representation": "version-B"
          }
        ]
      },
      "expected": [
        {
          "index": 0,
          "headers": {
            "origin": "https://a.example"
          },
          "representation": "version-A",
          "key": "[\"/synthetic/resource\",[\"origin\",\"https://a.example\"]]"
        },
        {
          "index": 1,
          "headers": {
            "origin": "https://b.example"
          },
          "representation": "version-B",
          "key": "[\"/synthetic/resource\",[\"origin\",\"https://b.example\"]]"
        }
      ]
    }
  ]
}