{
  "app": "Dialect Desk",
  "scope": "Approved string tables, no file operations. Canonical CSV is data, not spreadsheet-safe formula execution.",
  "tables": [
    {
      "id": "Interview",
      "contract": {
        "delimiter": ",",
        "columns": 2,
        "header": true
      },
      "header": [
        "speaker",
        "quotation"
      ],
      "rows": [
        [
          "A",
          "We said \"yes\", together"
        ],
        [
          "B",
          "First thought\nSecond thought"
        ]
      ],
      "canonicalCsv": "speaker,quotation\r\nA,\"We said \"\"yes\"\", together\"\r\nB,\"First thought\nSecond thought\"\r\n"
    },
    {
      "id": "Readings",
      "contract": {
        "delimiter": ";",
        "columns": 2,
        "header": false
      },
      "header": null,
      "rows": [
        [
          "T01",
          "21.5"
        ],
        [
          "T02",
          "22;check"
        ],
        [
          "T03",
          "23.0"
        ]
      ],
      "canonicalCsv": "T01;21.5\r\nT02;\"22;check\"\r\nT03;23.0\r\n"
    },
    {
      "id": "Accessions",
      "contract": {
        "delimiter": "\t",
        "columns": 2,
        "header": true
      },
      "header": [
        "id",
        "title"
      ],
      "rows": [
        [
          "M01",
          "Blue\tSky"
        ],
        [
          "M02",
          "A \"quoted\" title"
        ]
      ],
      "canonicalCsv": "id\ttitle\r\nM01\t\"Blue\tSky\"\r\nM02\t\"A \"\"quoted\"\" title\"\r\n"
    }
  ]
}